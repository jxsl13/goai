#version 450

// GELU backward dx = g·(Φ(x)+x·φ(x)), Φ=0.5(1+erf(x/√2)), φ=(1/√2π)exp(−x²/2), one
// invocation per element (§T353: the VJP was a ~30ms CPU scalar loop at the FFN's
// 256×2048). GLSL lacks erf → Abramowitz & Stegun 7.1.26 approx, matching the reference
// within §V11 f32 tol. Flat row-major std430 f32. Compiled to gelu_bwd.spv by
// `make vulkan-spv` (glslc).

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer BufX { float x[]; };
layout(std430, binding = 1) readonly buffer BufG { float g[]; };
layout(std430, binding = 2) writeonly buffer BufDX { float dx[]; };

layout(push_constant) uniform Dims { int n; } d;

float aserf(float xv) {
    float ax = abs(xv);
    float t = 1.0 / (1.0 + 0.3275911 * ax);
    float y = 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * exp(-ax * ax);
    return xv >= 0.0 ? y : -y;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(d.n)) {
        return;
    }
    float xv = x[i];
    float phi = 0.5 * (1.0 + aserf(xv * 0.70710678118654752));
    float pdf = 0.39894228040143270 * exp(-0.5 * xv * xv);
    dx[i] = g[i] * (phi + xv * pdf);
}
