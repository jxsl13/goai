#version 450

// Strided/offset f32 GEMM for the §T397 attention path: C = alpha · A·(B or Bᵀ), where A, B, C are
// WINDOWS of larger packed buffers (a head is a dk-column slice of a [seq,dm] row). Generalizes
// matmul.comp with per-operand row strides (lda/ldb/ldc), byte-free element offsets (offA/offB/offC),
// and an alpha scale (folds 1/√dk into Q·Kᵀ). Same 16×16 tiled scheme. Logical dims M,K,N drive the
// loop/tile bounds; the strides address the packed storage.
//
// Attention use (per head h, kv head hh, seq=S, dk=d, dm=heads·d, kvDim=kvHeads·d):
//   S = scale·Q_h·K_hᵀ : A=Q offA=h·d lda=dm ; B=K offB=hh·d ldb=kvDim transB=1 ; C=S offC=0 ldc=S ; alpha=scale
//   O_h = P·V_h        : A=P offA=0 lda=S   ; B=V offB=hh·d ldb=kvDim transB=0 ; C=O offC=h·d ldc=dm ; alpha=1

#define TS 16
layout(local_size_x = TS, local_size_y = TS, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer BufA { float a[]; };
layout(std430, binding = 1) readonly buffer BufB { float b[]; };
layout(std430, binding = 2) writeonly buffer BufC { float c[]; };

layout(push_constant) uniform Dims {
    int M; int K; int N; int transA; int transB;
    int lda; int ldb; int ldc; int offA; int offB; int offC; float alpha;
} d;

shared float As[TS][TS];
shared float Bs[TS][TS];

void main() {
    uint tx = gl_LocalInvocationID.x;
    uint ty = gl_LocalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;
    uint row = gl_GlobalInvocationID.y;

    float sum = 0.0;
    int tiles = (d.K + TS - 1) / TS;
    for (int t = 0; t < tiles; ++t) {
        uint aCol = uint(t) * TS + tx;
        uint bRow = uint(t) * TS + ty;
        bool aIn = row < uint(d.M) && aCol < uint(d.K);
        // A(row, aCol): non-trans stored [M,K] stride lda; trans stored [K,M] stride lda.
        As[ty][tx] = aIn ? (d.transA != 0 ? a[uint(d.offA) + aCol * uint(d.lda) + row]
                                          : a[uint(d.offA) + row * uint(d.lda) + aCol])
                         : 0.0;
        bool bIn = bRow < uint(d.K) && col < uint(d.N);
        // B_eff(bRow, col): transB=1 → B stored [N,K] i.e. B(col,bRow) at offB+col*ldb+bRow;
        //                   transB=0 → B stored [K,N] i.e. B(bRow,col) at offB+bRow*ldb+col.
        Bs[ty][tx] = bIn ? (d.transB != 0 ? b[uint(d.offB) + col * uint(d.ldb) + bRow]
                                          : b[uint(d.offB) + bRow * uint(d.ldb) + col])
                         : 0.0;
        barrier();
        for (int i = 0; i < TS; ++i) {
            sum += As[ty][i] * Bs[i][tx];
        }
        barrier();
    }
    if (row < uint(d.M) && col < uint(d.N)) {
        c[uint(d.offC) + row * uint(d.ldc) + col] = d.alpha * sum;
    }
}
