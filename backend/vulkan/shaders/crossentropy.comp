#version 450

// Cross-entropy forward (§T403, mirrors metal §T401): per row b, lseᵢ=max+logΣexp(z−max);
// Lᵢ=lseᵢ−z[targetᵢ]. One 256-invocation workgroup per [b,c] row (cooperative). Basic case only.
#define WG 256
layout(local_size_x = WG, local_size_y = 1, local_size_z = 1) in;
layout(std430, binding = 0) readonly buffer BufZ { float z[]; };
layout(std430, binding = 1) readonly buffer BufT { float tg[]; };
layout(std430, binding = 2) writeonly buffer BufL { float l[]; };
layout(push_constant) uniform P { int b; int c; } p;
shared float red[WG];
void main() {
    uint row = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    if (int(row) >= p.b) return;
    int base = int(row) * p.c;
    float m = -1.0 / 0.0;
    for (int j = int(lane); j < p.c; j += WG) m = max(m, z[base + j]);
    red[lane] = m; barrier();
    for (uint s = WG / 2u; s > 0u; s >>= 1u) { if (lane < s) red[lane] = max(red[lane], red[lane + s]); barrier(); }
    m = red[0];
    float sum = 0.0;
    for (int j = int(lane); j < p.c; j += WG) sum += exp(z[base + j] - m);
    red[lane] = sum; barrier();
    for (uint s = WG / 2u; s > 0u; s >>= 1u) { if (lane < s) red[lane] += red[lane + s]; barrier(); }
    if (lane == 0u) { float lse = m + log(red[0]); int ti = int(tg[row]); l[row] = lse - z[base + ti]; }
}
