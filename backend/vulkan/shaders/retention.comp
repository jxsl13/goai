#version 450

// RetNet retention forward (§T173/§T179, the Vulkan twin of the Metal kernel §T172/§T178; Sun et al.
// 2023, §R114). One invocation per query row n streams keys m=n..0 with an incremental γ-decay
// (decay=1 at m=n, ×γ each step down) into a register accumulator acc[dv] — the parallel form
// O=(QKᵀ⊙D)V, D_nm=γ^(n−m), with NO [L,L] score matrix. Q,K are [L,dk], V,O are [L,dv] (value
// expansion dv≠dk supported). All flat row-major std430 f32, single head. dv bounded at 128 (fixed
// private accumulator); dk unbounded (streamed). Compiled to retention.spv by `make vulkan-spv`.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer BufQ { float q[]; };
layout(std430, binding = 1) readonly buffer BufK { float k[]; };
layout(std430, binding = 2) readonly buffer BufV { float v[]; };
layout(std430, binding = 3) writeonly buffer BufO { float o[]; };

layout(push_constant) uniform PC {
    int L; int dk; int dv; float gamma;
} p;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= uint(p.L)) {
        return; // dispatch rounds up to whole workgroups; mask the overhang
    }
    int n = int(gid);
    float acc[128];
    for (int j = 0; j < p.dv; ++j) { acc[j] = 0.0; }
    float decay = 1.0;
    for (int m = n; m >= 0; --m) {
        float dot = 0.0;
        for (int i = 0; i < p.dk; ++i) { dot += q[n * p.dk + i] * k[m * p.dk + i]; }
        float pm = dot * decay;
        for (int j = 0; j < p.dv; ++j) { acc[j] += pm * v[m * p.dv + j]; }
        decay *= p.gamma;
    }
    for (int j = 0; j < p.dv; ++j) { o[n * p.dv + j] = acc[j]; }
}
