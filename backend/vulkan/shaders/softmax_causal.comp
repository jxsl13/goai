#version 450

// Row softmax of the [rows,cols] score matrix S IN PLACE, with an optional causal mask (col j > row i
// excluded). One 256-invocation workgroup per row (cooperative, mirrors metal §T394). Masked-out
// entries are zeroed so the subsequent S·V ignores them. The scale is pre-folded into S by the
// strided matmul's alpha. §T397.

#define WG 256
layout(local_size_x = WG, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) buffer BufS { float s[]; };
layout(push_constant) uniform P { int rows; int cols; int causal; } p;

shared float red[WG];

void main() {
    uint row = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    if (int(row) >= p.rows) return;
    int base = int(row) * p.cols;
    int jmax = (p.causal != 0) ? (int(row) + 1) : p.cols;

    // row max over valid columns
    float m = -1.0 / 0.0; // -inf
    for (int j = int(lane); j < jmax; j += WG) m = max(m, s[base + j]);
    red[lane] = m;
    barrier();
    for (uint st = WG / 2u; st > 0u; st >>= 1u) {
        if (lane < st) red[lane] = max(red[lane], red[lane + st]);
        barrier();
    }
    m = red[0];

    // exp and sum over valid columns
    float sum = 0.0;
    for (int j = int(lane); j < jmax; j += WG) {
        float e = exp(s[base + j] - m);
        s[base + j] = e;
        sum += e;
    }
    red[lane] = sum;
    barrier();
    for (uint st = WG / 2u; st > 0u; st >>= 1u) {
        if (lane < st) red[lane] += red[lane + st];
        barrier();
    }
    float inv = 1.0 / red[0];

    // normalize valid, zero the masked tail
    for (int j = int(lane); j < p.cols; j += WG) {
        s[base + j] = (j < jmax) ? s[base + j] * inv : 0.0;
    }
}
