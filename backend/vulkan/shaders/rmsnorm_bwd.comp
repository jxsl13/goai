#version 450
#extension GL_EXT_shader_atomic_float : require

// RMSNorm backward (§R29/§R35). COOPERATIVE (§T347): ONE workgroup of 256 invocations
// per ROW, coalesced strided access. With r=1/√(mean(x²)+eps), a=g⊙γ, s=Σₖ aₖxₖ per row:
// a single strided pass accumulates both per-row sums (ms=Σx², s) into shared scratch, one
// tree reduction combines them, then each lane writes its strided dx_j = r·(a_j − x_j·r²·s/d)
// and atomically adds dγ_j = g_j·x_j·r into the cross-row accumulator (host-zeroed). Flat
// row-major std430 f32. Compiled to rmsnorm_bwd.spv by `make vulkan-spv`; needs
// VK_EXT_shader_atomic_float (Go falls back to the reference otherwise). Dispatch is `rows`
// workgroups of 256. f32 vs the reference's f64, §V11 dim-scaled tolerance.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer BufX { float x[]; };
layout(std430, binding = 1) readonly buffer BufGamma { float gam[]; };
layout(std430, binding = 2) readonly buffer BufG { float gup[]; };
layout(std430, binding = 3) writeonly buffer BufDX { float dx[]; };
layout(std430, binding = 4) buffer BufDGamma { float dgamma[]; };

layout(push_constant) uniform Dims { int rows; int dim; float eps; } d;

shared float redA[256];
shared float redB[256];

void main() {
    uint row = gl_WorkGroupID.x;
    if (row >= uint(d.rows)) {
        return; // whole workgroup returns together → barriers stay uniform
    }
    uint lane = gl_LocalInvocationID.x;
    uint base = row * uint(d.dim);
    float pms = 0.0;
    float ps = 0.0;
    for (int j = int(lane); j < d.dim; j += 256) {
        float v = x[base + uint(j)];
        pms += v * v;
        ps += gup[base + uint(j)] * gam[uint(j)] * v;
    }
    redA[lane] = pms;
    redB[lane] = ps;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1) {
        if (lane < s) { redA[lane] += redA[lane + s]; redB[lane] += redB[lane + s]; }
        barrier();
    }
    float r = inversesqrt(redA[0] / float(d.dim) + d.eps);
    float coef = r * r * r * redB[0] / float(d.dim);
    for (int j = int(lane); j < d.dim; j += 256) {
        float aj = gup[base + uint(j)] * gam[uint(j)];
        dx[base + uint(j)] = r * aj - x[base + uint(j)] * coef;
        atomicAdd(dgamma[uint(j)], gup[base + uint(j)] * x[base + uint(j)] * r);
    }
}
