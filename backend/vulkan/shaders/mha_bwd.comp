#version 450
#extension GL_EXT_shader_atomic_float : require

// Fused SDPA backward (§T90, the Vulkan twin of the Metal kernel §T86). One
// invocation per (head, query row) recomputes the softmax (max/sum/dot passes
// mirroring the reference), writes its own dQ row directly, and atomically
// accumulates into the shared dK/dV (which GQA query-heads and all query rows
// contribute to — hence the float atomicAdd, VK_EXT_shader_atomic_float). dK/dV
// buffers are uploaded pre-zeroed. dk ≤ 128 (fixed private accumulator).

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer BufQ { float q[]; };
layout(std430, binding = 1) readonly buffer BufK { float k[]; };
layout(std430, binding = 2) readonly buffer BufV { float v[]; };
layout(std430, binding = 3) readonly buffer BufDO { float dO[]; };
layout(std430, binding = 4) writeonly buffer BufDQ { float dQ[]; };
layout(std430, binding = 5) buffer BufDK { float dK[]; };
layout(std430, binding = 6) buffer BufDV { float dV[]; };

layout(push_constant) uniform PC {
    int sq; int sk; int dm; int heads; int kvHeads; int dk; int causal; int window; float scale;
} p;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= uint(p.heads * p.sq)) {
        return;
    }
    int h = int(gid) / p.sq;
    int i = int(gid) % p.sq;
    int rep = p.heads / p.kvHeads;
    int dkv = p.kvHeads * p.dk;
    int qOff = h * p.dk;
    int kvOff = (h / rep) * p.dk;
    int off = p.sk - p.sq;
    int jmax = (p.causal != 0) ? (off + i + 1) : p.sk;
    // sliding window (§T129, §R62): restrict each query to its `window` most recent keys
    int jmin = (p.window > 0 && off + i - p.window + 1 > 0) ? (off + i - p.window + 1) : 0;

    // pass A: row max
    float m = -1e30;
    for (int j = jmin; j < jmax; ++j) {
        float s = 0.0;
        for (int d = 0; d < p.dk; ++d) { s += q[i * p.dm + qOff + d] * k[j * dkv + kvOff + d]; }
        m = max(m, s * p.scale);
    }
    // pass B: softmax denominator
    float sum = 0.0;
    for (int j = jmin; j < jmax; ++j) {
        float s = 0.0;
        for (int d = 0; d < p.dk; ++d) { s += q[i * p.dm + qOff + d] * k[j * dkv + kvOff + d]; }
        sum += exp(s * p.scale - m);
    }
    // pass C: dot = Σ_j A[j]·dA[j]
    float dot = 0.0;
    for (int j = jmin; j < jmax; ++j) {
        float s = 0.0;
        for (int d = 0; d < p.dk; ++d) { s += q[i * p.dm + qOff + d] * k[j * dkv + kvOff + d]; }
        float a = exp(s * p.scale - m) / sum;
        float da = 0.0;
        for (int d = 0; d < p.dk; ++d) { da += dO[i * p.dm + qOff + d] * v[j * dkv + kvOff + d]; }
        dot += a * da;
    }
    // pass D: gradients — dQ private (own row), dK/dV atomic (shared)
    float dQloc[128];
    for (int d = 0; d < p.dk; ++d) { dQloc[d] = 0.0; }
    for (int j = jmin; j < jmax; ++j) {
        float s = 0.0;
        for (int d = 0; d < p.dk; ++d) { s += q[i * p.dm + qOff + d] * k[j * dkv + kvOff + d]; }
        float a = exp(s * p.scale - m) / sum;
        float da = 0.0;
        for (int d = 0; d < p.dk; ++d) { da += dO[i * p.dm + qOff + d] * v[j * dkv + kvOff + d]; }
        float dS = p.scale * a * (da - dot);
        for (int d = 0; d < p.dk; ++d) {
            atomicAdd(dV[j * dkv + kvOff + d], a * dO[i * p.dm + qOff + d]);
            atomicAdd(dK[j * dkv + kvOff + d], dS * q[i * p.dm + qOff + d]);
            dQloc[d] += dS * k[j * dkv + kvOff + d];
        }
    }
    for (int d = 0; d < p.dk; ++d) { dQ[i * p.dm + qOff + d] = dQloc[d]; }
}
