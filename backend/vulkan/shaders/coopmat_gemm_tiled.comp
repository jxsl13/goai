#version 450
// coopmat_gemm_tiled.comp — Tw-COOPMAT slice 4: the llama.cpp mul_mm.comp COOPMAT shape,
// simplified. One workgroup = 128 threads = 4 subgroups computing a BM=64 × BN=64 C tile;
// per BK=32 K-step the A (64×32) and B (32×64) blocks are staged to shared memory once,
// cooperatively and coalesced, then each subgroup consumes them as coopmat fragments:
// subgroup s owns C rows [s·16, s·16+16) — its A fragments come from shared row band s,
// the B block is shared by ALL four subgroups (4× global-traffic reuse vs the naive probe,
// which also had zero A coalescing). Requires M%64==0, N%64==0, K%32==0.
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly  buffer A { float16_t a[]; };  // [M,K] row-major f16
layout(binding = 1) readonly  buffer B { float16_t b[]; };  // [K,N] row-major f16
layout(binding = 2) writeonly buffer C { float c[]; };      // [M,N] row-major f32

layout(push_constant) uniform Push { int M; int K; int N; } pc;

const uint BM = 64u, BN = 64u, BK = 32u;

shared float16_t As[BM * BK]; // [64,32] row-major
shared float16_t Bs[BK * BN]; // [32,64] row-major

void main() {
    uint tileRow = gl_WorkGroupID.y * BM;
    uint tileCol = gl_WorkGroupID.x * BN;
    uint tid = gl_LocalInvocationID.x;           // 0..127
    uint sg = tid / 32u;                          // subgroup id 0..3 (NVIDIA subgroupSize=32)
    uint K = uint(pc.K), N = uint(pc.N);

    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc0 =
        coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc1 = acc0;
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc2 = acc0;
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc3 = acc0;

    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> ma;
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> mb;

    for (uint k0 = 0u; k0 < K; k0 += BK) {
        // Stage A[tileRow..+64, k0..+32] and B[k0..+32, tileCol..+64]: 2048 f16 each,
        // 16 elements per thread, consecutive threads take consecutive columns (coalesced).
        for (uint i = tid; i < BM * BK; i += 128u) {
            uint r = i / BK, ccol = i % BK;
            As[i] = a[(tileRow + r) * K + k0 + ccol];
        }
        for (uint i = tid; i < BK * BN; i += 128u) {
            uint r = i / BN, ccol = i % BN;
            Bs[i] = b[(k0 + r) * N + tileCol + ccol];
        }
        barrier();

        // Subgroup sg consumes shared row band sg: two 16-wide K-steps per BK block.
        for (uint kk = 0u; kk < BK; kk += 16u) {
            coopMatLoad(ma, As, (sg * 16u) * BK + kk, BK, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(mb, Bs, kk * BN, BN, gl_CooperativeMatrixLayoutRowMajor);
            acc0 = coopMatMulAdd(ma, mb, acc0);
            coopMatLoad(mb, Bs, kk * BN + 16u, BN, gl_CooperativeMatrixLayoutRowMajor);
            acc1 = coopMatMulAdd(ma, mb, acc1);
            coopMatLoad(mb, Bs, kk * BN + 32u, BN, gl_CooperativeMatrixLayoutRowMajor);
            acc2 = coopMatMulAdd(ma, mb, acc2);
            coopMatLoad(mb, Bs, kk * BN + 48u, BN, gl_CooperativeMatrixLayoutRowMajor);
            acc3 = coopMatMulAdd(ma, mb, acc3);
        }
        barrier();
    }

    uint outRow = tileRow + sg * 16u;
    coopMatStore(acc0, c, outRow * N + tileCol, N, gl_CooperativeMatrixLayoutRowMajor);
    coopMatStore(acc1, c, outRow * N + tileCol + 16u, N, gl_CooperativeMatrixLayoutRowMajor);
    coopMatStore(acc2, c, outRow * N + tileCol + 32u, N, gl_CooperativeMatrixLayoutRowMajor);
    coopMatStore(acc3, c, outRow * N + tileCol + 48u, N, gl_CooperativeMatrixLayoutRowMajor);
}
