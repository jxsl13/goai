#version 450

// im2col unroll for the conv2d GEMM lowering (§T342, the Vulkan twin of the Metal
// §T341 stage 1): col[c·KH·KW + ky·KW + kx, (n·ho+oy)·wo + ox] =
// X[n,c,oy·stride+ky−pad,ox·stride+kx−pad], 0 where the tap lands in padding.
// One invocation per col element; every element is written (pool stale-safety).

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer BufX { float x[]; };
layout(std430, binding = 1) writeonly buffer BufCol { float col[]; };

layout(push_constant) uniform PC {
    int N; int C; int H; int Wd; int F; int KH; int KW; int stride; int pad; int ho; int wo;
} p;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    int cols = p.N * p.ho * p.wo;
    int rows = p.C * p.KH * p.KW;
    if (gid >= uint(rows * cols)) {
        return;
    }
    int row = int(gid) / cols;
    int c0 = int(gid) % cols;
    int kx = row % p.KW;
    int ky = (row / p.KW) % p.KH;
    int c = row / (p.KW * p.KH);
    int ox = c0 % p.wo;
    int oy = (c0 / p.wo) % p.ho;
    int n = c0 / (p.wo * p.ho);
    int iy = oy * p.stride + ky - p.pad;
    int ix = ox * p.stride + kx - p.pad;
    float v = (iy < 0 || iy >= p.H || ix < 0 || ix >= p.Wd)
        ? 0.0
        : x[((n * p.C + c) * p.H + iy) * p.Wd + ix];
    col[gid] = v;
}
