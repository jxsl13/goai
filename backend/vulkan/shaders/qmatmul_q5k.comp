#version 450

// Q5_K quantized matmul (§T144, the Vulkan twin of the Metal kernel §T143). Q4_K's
// asymmetric-affine matmul plus the qh high-bit plane. Block is 176 B (f16 d, f16 dmin,
// scales[12], qh[32], qs[128]); q5 = nibble | (qh bit)<<4 ∈ [0,31], and per pair pr the
// low-nibble sub-block uses qh bit u1=1<<2pr, the high-nibble uses u2=2<<2pr. Reconstruction
// y = d·sc6·q5 − dmin·min6, the 6-bit scale/min from get_scale_min_k4. The weight buffer is the
// raw bytes as a uint word array (portable); f16 d/dmin use unpackHalf2x16. Compiled by
// `make vulkan-spv` (glslc).

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer BufX { float x[]; };
layout(std430, binding = 1) readonly buffer BufW { uint w[]; };
layout(std430, binding = 2) writeonly buffer BufO { float o[]; };

layout(push_constant) uniform PC {
    int M; int K; int N;
} p;

uint getByte(int off) {
    uint word = w[off >> 2];
    return (word >> ((uint(off & 3)) * 8u)) & 0xFFu;
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= uint(p.M * p.N)) {
        return;
    }
    int mi = int(gid) / p.N;
    int ni = int(gid) % p.N;
    int nsb = p.K / 256;
    int rowBytes = nsb * 176;
    int rowOff = ni * rowBytes;

    float acc = 0.0;
    for (int sb = 0; sb < nsb; ++sb) {
        int base = rowOff + sb * 176;
        uint dr = getByte(base) | (getByte(base + 1) << 8);
        uint dmr = getByte(base + 2) | (getByte(base + 3) << 8);
        float d = unpackHalf2x16(dr).x;
        float dmin = unpackHalf2x16(dmr).x;
        int sbase = base + 4;
        int qhB = base + 16;
        int qsB = base + 48;
        for (int pr = 0; pr < 4; ++pr) {
            uint u1 = 1u << uint(2 * pr);
            uint u2 = 2u << uint(2 * pr);
            for (int hf = 0; hf < 2; ++hf) {
                int is = pr * 2 + hf;
                int sc, mn;
                if (is < 4) {
                    sc = int(getByte(sbase + is) & 63u);
                    mn = int(getByte(sbase + is + 4) & 63u);
                } else {
                    sc = int((getByte(sbase + is + 4) & 0xFu) | ((getByte(sbase + is - 4) >> 6) << 4));
                    mn = int((getByte(sbase + is + 4) >> 4) | ((getByte(sbase + is) >> 6) << 4));
                }
                float dl = d * float(sc);
                float ml = dmin * float(mn);
                uint um = (hf == 0) ? u1 : u2;
                int qb = qsB + pr * 32;
                int xk = mi * p.K + sb * 256 + pr * 64 + hf * 32;
                for (int l = 0; l < 32; ++l) {
                    uint qbyte = getByte(qb + l);
                    int nib = (hf == 0) ? int(qbyte & 0xFu) : int(qbyte >> 4);
                    int hb = ((getByte(qhB + l) & um) != 0u) ? 16 : 0;
                    acc += x[xk + l] * (dl * float(nib + hb) - ml);
                }
            }
        }
    }
    o[mi * p.N + ni] = acc;
}
