#version 450
// coopmat_gemm_f16acc.comp — v2 geometry (32M×64N/subgroup, 8 accumulators) but with
// float16_t ACCUMULATORS instead of f32. This is the cuBLAS-parity lever: on GeForce/GA10x
// the f16-input tensor path runs at FULL rate with f16 accumulate but HALF rate with f32
// accumulate (the same lever the CUDA prefill uses via CUBLAS_COMPUTE_16F, Tw61). Our f32-acc
// coopmat therefore capped at ~half the tensor peak (~7-8 TFLOP/s); f16 accumulate should ~2x
// toward the cuBLAS-f16 26.5 TFLOP/s mark. Accumulation precision: f16 over K (the accepted
// prefill tradeoff — norm-rel-RMS ~2-5e-3, gated in the test). Output converted to f32 on store.
// M%32==0, N%64==0, K%16==0.
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly  buffer A { float16_t a[]; };
layout(binding = 1) readonly  buffer B { float16_t b[]; };
layout(binding = 2) writeonly buffer C { float c[]; };

layout(push_constant) uniform Push { int M; int K; int N; } pc;

#define ACC coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>

void main() {
    uint tileRow = gl_WorkGroupID.y * 32u;
    uint tileCol = gl_WorkGroupID.x * 64u;
    uint K = uint(pc.K), N = uint(pc.N);

    ACC acc00 = ACC(float16_t(0.0));
    ACC acc01 = acc00, acc02 = acc00, acc03 = acc00;
    ACC acc10 = acc00, acc11 = acc00, acc12 = acc00, acc13 = acc00;

    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> ma0;
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> ma1;
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> mb;

    for (uint k = 0u; k < K; k += 16u) {
        coopMatLoad(ma0, a, tileRow * K + k, K, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(ma1, a, (tileRow + 16u) * K + k, K, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(mb, b, k * N + tileCol, N, gl_CooperativeMatrixLayoutRowMajor);
        acc00 = coopMatMulAdd(ma0, mb, acc00);
        acc10 = coopMatMulAdd(ma1, mb, acc10);
        coopMatLoad(mb, b, k * N + tileCol + 16u, N, gl_CooperativeMatrixLayoutRowMajor);
        acc01 = coopMatMulAdd(ma0, mb, acc01);
        acc11 = coopMatMulAdd(ma1, mb, acc11);
        coopMatLoad(mb, b, k * N + tileCol + 32u, N, gl_CooperativeMatrixLayoutRowMajor);
        acc02 = coopMatMulAdd(ma0, mb, acc02);
        acc12 = coopMatMulAdd(ma1, mb, acc12);
        coopMatLoad(mb, b, k * N + tileCol + 48u, N, gl_CooperativeMatrixLayoutRowMajor);
        acc03 = coopMatMulAdd(ma0, mb, acc03);
        acc13 = coopMatMulAdd(ma1, mb, acc13);
    }

    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> f;
    f = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(acc00);
    coopMatStore(f, c, tileRow * N + tileCol, N, gl_CooperativeMatrixLayoutRowMajor);
    f = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(acc01);
    coopMatStore(f, c, tileRow * N + tileCol + 16u, N, gl_CooperativeMatrixLayoutRowMajor);
    f = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(acc02);
    coopMatStore(f, c, tileRow * N + tileCol + 32u, N, gl_CooperativeMatrixLayoutRowMajor);
    f = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(acc03);
    coopMatStore(f, c, tileRow * N + tileCol + 48u, N, gl_CooperativeMatrixLayoutRowMajor);
    f = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(acc10);
    coopMatStore(f, c, (tileRow + 16u) * N + tileCol, N, gl_CooperativeMatrixLayoutRowMajor);
    f = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(acc11);
    coopMatStore(f, c, (tileRow + 16u) * N + tileCol + 16u, N, gl_CooperativeMatrixLayoutRowMajor);
    f = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(acc12);
    coopMatStore(f, c, (tileRow + 16u) * N + tileCol + 32u, N, gl_CooperativeMatrixLayoutRowMajor);
    f = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(acc13);
    coopMatStore(f, c, (tileRow + 16u) * N + tileCol + 48u, N, gl_CooperativeMatrixLayoutRowMajor);
}
