#version 450

// Q4_K quantized matmul (§T139, the Vulkan twin of the Metal kernel §T138). One invocation per
// output (mi,ni) streams the ni-th weight row's K/256 Q4_K super-blocks (144 B: f16 d, f16
// dmin, scales[12], qs[128]), dequantizing in-kernel. Asymmetric affine
// y = d·sc6·nibble − dmin·min6; the 6-bit per-sub-block scale/min come from the
// get_scale_min_k4 splice. Traversal mirrors dequantize_row_q4_K: 4 pairs, low nibbles →
// sub-block is+0, high nibbles → is+1. The weight buffer is the raw bytes as a uint word array
// (portable — no 8/16-bit-storage extension); the f16 d/dmin use unpackHalf2x16. Compiled to
// qmatmul_q4k.spv by `make vulkan-spv` (glslc).

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer BufX { float x[]; };
layout(std430, binding = 1) readonly buffer BufW { uint w[]; };
layout(std430, binding = 2) writeonly buffer BufO { float o[]; };

layout(push_constant) uniform PC {
    int M; int K; int N;
} p;

uint getByte(int off) {
    uint word = w[off >> 2];
    return (word >> ((uint(off & 3)) * 8u)) & 0xFFu;
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= uint(p.M * p.N)) {
        return;
    }
    int mi = int(gid) / p.N;
    int ni = int(gid) % p.N;
    int nsb = p.K / 256;
    int rowBytes = nsb * 144;
    int rowOff = ni * rowBytes;

    float acc = 0.0;
    for (int sb = 0; sb < nsb; ++sb) {
        int base = rowOff + sb * 144;
        uint dr = getByte(base) | (getByte(base + 1) << 8);
        uint dmr = getByte(base + 2) | (getByte(base + 3) << 8);
        float d = unpackHalf2x16(dr).x;
        float dmin = unpackHalf2x16(dmr).x;
        int sbase = base + 4;
        int qbase = base + 16;
        for (int pr = 0; pr < 4; ++pr) {
            for (int hf = 0; hf < 2; ++hf) {
                int is = pr * 2 + hf;
                int sc, mn;
                if (is < 4) {
                    sc = int(getByte(sbase + is) & 63u);
                    mn = int(getByte(sbase + is + 4) & 63u);
                } else {
                    sc = int((getByte(sbase + is + 4) & 0xFu) | ((getByte(sbase + is - 4) >> 6) << 4));
                    mn = int((getByte(sbase + is + 4) >> 4) | ((getByte(sbase + is) >> 6) << 4));
                }
                float dl = d * float(sc);
                float ml = dmin * float(mn);
                int qb = qbase + pr * 32;
                int xk = mi * p.K + sb * 256 + pr * 64 + hf * 32;
                for (int l = 0; l < 32; ++l) {
                    uint qbyte = getByte(qb + l);
                    int nib = (hf == 0) ? int(qbyte & 0xFu) : int(qbyte >> 4);
                    acc += x[xk + l] * (dl * float(nib) - ml);
                }
            }
        }
    }
    o[mi * p.N + ni] = acc;
}
