#version 450

// Bias add o[i,j] = x[i,j] + b[j] (bias broadcast over rows), one invocation per element
// (§T352: was a ref/CPU fallback dominating the FFN — now on-GPU). Flat row-major std430
// f32 buffers. Compiled to addbias.spv by `make vulkan-spv` (glslc). f32 vs the reference's
// f64, so §V11 allows a tolerance.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer BufX { float x[]; };
layout(std430, binding = 1) readonly buffer BufB { float b[]; };
layout(std430, binding = 2) writeonly buffer BufO { float o[]; };

layout(push_constant) uniform Dims { int rows; int n; } d;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(d.rows * d.n)) {
        return;
    }
    o[i] = x[i] + b[int(i) % d.n];
}
