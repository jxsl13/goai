#version 450

// Row softmax IN PLACE over a PACKED per-head score buffer [heads·seq, cols] (§T528, the
// backward-chain sibling of softmax_causal.comp): the causal mask uses the row's position
// WITHIN ITS HEAD (row % seqLen), which softmax_causal cannot express. Masked entries are
// zeroed so the downstream matmuls ignore them. One 256-invocation workgroup per row.

#define WG 256
layout(local_size_x = WG, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) buffer BufS { float s[]; };
layout(push_constant) uniform P { int rows; int cols; int seqLen; int causal; } p;

shared float red[WG];

void main() {
    uint row = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    if (int(row) >= p.rows) return;
    int base = int(row) * p.cols;
    int qpos = int(row) % p.seqLen;
    int jmax = (p.causal != 0) ? (qpos + 1) : p.cols;

    float m = -1.0 / 0.0;
    for (int j = int(lane); j < jmax; j += WG) m = max(m, s[base + j]);
    red[lane] = m;
    barrier();
    for (uint st = WG / 2u; st > 0u; st >>= 1u) {
        if (lane < st) red[lane] = max(red[lane], red[lane + st]);
        barrier();
    }
    m = red[0];
    barrier();

    float sum = 0.0;
    for (int j = int(lane); j < jmax; j += WG) {
        float e = exp(s[base + j] - m);
        s[base + j] = e;
        sum += e;
    }
    red[lane] = sum;
    barrier();
    for (uint st = WG / 2u; st > 0u; st >>= 1u) {
        if (lane < st) red[lane] += red[lane + st];
        barrier();
    }
    sum = red[0];
    float inv = (sum > 0.0) ? (1.0 / sum) : 0.0;
    for (int j = int(lane); j < p.cols; j += WG) {
        s[base + j] = (j < jmax) ? s[base + j] * inv : 0.0;
    }
}
