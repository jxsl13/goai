#version 450

// FlashAttention-2 forward (§T110, the Vulkan twin of the Metal kernel §T109; Dao
// 2023, §R72). One invocation per (head, query row) streams the keys ONCE with the
// online-softmax recurrence — a running max m, normalizer l and an O(dk) accumulator
// acc — so no [seq,seq] score row is materialized (the flash memory win). Q,K,V are
// all flat row-major std430 f32 [seq,dm] (sq==sk, no GQA), off = h*dk. corr = exp(m_old
// − m_new) rescales the accumulators when the max grows; m starts at −1e30 so on the
// first key corr = exp(−huge) = 0 and the accumulators initialize cleanly. Normalize
// by l once at the end. dk bounded at 128 (fixed private accumulator). Compiled to
// flashattn.spv by `make vulkan-spv`, embedded by vulkan.go.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer BufQ { float q[]; };
layout(std430, binding = 1) readonly buffer BufK { float k[]; };
layout(std430, binding = 2) readonly buffer BufV { float v[]; };
layout(std430, binding = 3) writeonly buffer BufO { float o[]; };

layout(push_constant) uniform PC {
    int seq; int dm; int heads; int dk; int causal; int kvHeads; float scale;
} p;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    int total = p.heads * p.seq;
    if (gid >= uint(total)) {
        return; // dispatch rounds up to whole workgroups; mask the overhang
    }
    int h = int(gid) / p.seq;
    int i = int(gid) % p.seq;
    // GQA/MQA: query head h shares K/V head h/(heads/kvHeads); K,V are [seq,kvHeads*dk]
    int rep = p.heads / p.kvHeads;
    int dkv = p.kvHeads * p.dk;
    int qOff = h * p.dk;
    int kvOff = (h / rep) * p.dk;
    int jmax = (p.causal != 0) ? (i + 1) : p.seq;

    float m = -1e30;
    float l = 0.0;
    float acc[128];
    for (int d = 0; d < p.dk; ++d) { acc[d] = 0.0; }
    for (int j = 0; j < jmax; ++j) {
        float s = 0.0;
        for (int d = 0; d < p.dk; ++d) { s += q[i * p.dm + qOff + d] * k[j * dkv + kvOff + d]; }
        s *= p.scale;
        float mNew = max(m, s);
        float corr = exp(m - mNew);
        float pe = exp(s - mNew);
        l = corr * l + pe;
        for (int d = 0; d < p.dk; ++d) { acc[d] = corr * acc[d] + pe * v[j * dkv + kvOff + d]; }
        m = mNew;
    }
    for (int d = 0; d < p.dk; ++d) { o[i * p.dm + qOff + d] = acc[d] / l; }
}
