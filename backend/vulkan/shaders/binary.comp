#version 450

// Generic SAME-SHAPE binary elementwise op, one invocation per element:
// o[i] = f(op, a[i], b[i]). The op selector (push constant) picks the function so a
// single kernel serves Add/Sub/Mul/Div/Maximum/Minimum. Broadcasting (unequal shapes) is
// NOT handled here — the Go dispatch falls back to the reference for that. Flat row-major
// std430 f32 buffers. Compiled to binary.spv by `make vulkan-spv` (glslc). f32 vs the
// reference's f64, so §V11 allows a tolerance.
//
// op codes (must match backend/vulkan/vulkan.go): 0 Add, 1 Sub, 2 Mul, 3 Div, 4 Maximum,
// 5 Minimum.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer BufA { float a[]; };
layout(std430, binding = 1) readonly buffer BufB { float b[]; };
layout(std430, binding = 2) writeonly buffer BufO { float o[]; };

layout(push_constant) uniform Dims { int n; int op; } d;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(d.n)) {
        return;
    }
    float x = a[i];
    float y = b[i];
    float r;
    switch (d.op) {
        case 0:  r = x + y; break;
        case 1:  r = x - y; break;
        case 2:  r = x * y; break;
        case 3:  r = x / y; break;
        case 4:  r = max(x, y); break;
        case 5:  r = min(x, y); break;
        default: r = x; break;
    }
    o[i] = r;
}
