#version 450

// Embed forward (§T403, mirrors metal §T402): row gather O[i,:]=Table[idx[i],:]. One invocation
// per output element.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(std430, binding = 0) readonly buffer BufT { float t[]; };
layout(std430, binding = 1) readonly buffer BufI { float idx[]; };
layout(std430, binding = 2) writeonly buffer BufO { float o[]; };
layout(push_constant) uniform P { int m; int d; } p;
void main() {
    uint gid = gl_GlobalInvocationID.x;
    int total = p.m * p.d;
    if (int(gid) >= total) return;
    int i = int(gid) / p.d, j = int(gid) % p.d;
    int row = int(idx[i]);
    o[gid] = t[row * p.d + j];
}
