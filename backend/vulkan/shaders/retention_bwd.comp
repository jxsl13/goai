#version 450
#extension GL_EXT_shader_atomic_float : require

// RetNet retention backward (§T175/§T192, the Vulkan twin of the Metal kernel §T174/§T191; Sun et al.
// 2023, §R114). One invocation per query row n writes its own dQ row (private acc) and ATOMICALLY
// accumulates into the shared dK/dV (row m collects contributions from every n≥m — hence the float
// atomicAdd, VK_EXT_shader_atomic_float). dK/dV buffers are uploaded pre-zeroed. Forward O=(A⊙D)V,
// P=A⊙D; dQ_n=Σ_{m≤n}dA_nm·K_m, dK_m+=dA_nm·Q_n, dV_m+=P_nm·dO_n, dA_nm=(Σ_j dO_nj V_mj)·γ^(n−m).
// Value expansion dv≠dk supported: Q,K,dQ,dK are [L,dk], V,dO,dV are [L,dv]. dk ≤ 128 (private acc).

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer BufQ { float q[]; };
layout(std430, binding = 1) readonly buffer BufK { float k[]; };
layout(std430, binding = 2) readonly buffer BufV { float v[]; };
layout(std430, binding = 3) readonly buffer BufDO { float dO[]; };
layout(std430, binding = 4) writeonly buffer BufDQ { float dQ[]; };
layout(std430, binding = 5) buffer BufDK { float dK[]; };
layout(std430, binding = 6) buffer BufDV { float dV[]; };

layout(push_constant) uniform PC {
    int L; int dk; int dv; float gamma;
} p;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= uint(p.L)) {
        return;
    }
    int n = int(gid);
    float dqloc[128];
    for (int i = 0; i < p.dk; ++i) { dqloc[i] = 0.0; }
    float decay = 1.0;
    for (int m = n; m >= 0; --m) {
        float a = 0.0;
        for (int i = 0; i < p.dk; ++i) { a += q[n * p.dk + i] * k[m * p.dk + i]; }
        float pnm = a * decay;
        float dp = 0.0;
        for (int j = 0; j < p.dv; ++j) {
            float gnj = dO[n * p.dv + j];
            dp += gnj * v[m * p.dv + j];
            atomicAdd(dV[m * p.dv + j], pnm * gnj);
        }
        float dA = dp * decay;
        for (int i = 0; i < p.dk; ++i) {
            dqloc[i] += dA * k[m * p.dk + i];
            atomicAdd(dK[m * p.dk + i], dA * q[n * p.dk + i]);
        }
        decay *= p.gamma;
    }
    for (int i = 0; i < p.dk; ++i) { dQ[n * p.dk + i] = dqloc[i]; }
}
