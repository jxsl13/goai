#version 450
#extension GL_KHR_shader_subgroup_shuffle_relative : enable

// Cooperative single-query decode attention (§T429, the Vulkan twin of metal's mha_decode_f32
// §T428): the two-pass mha kernel runs ONE invocation per (head, query row) — at decode (sq=1)
// that is `heads` invocations total, each streaming all sk cached keys serially, so step time
// exploded linearly with context. Here ONE 32-lane SUBGROUP works per head: lanes partition the
// keys, each keeps an online-softmax partial (m, l, acc[dk]) in registers, and the merge uses
// subgroupShuffleDown (the standard (m,l,acc) combine — no shared memory, no atomics). dk ≤ 128.
// The both-empty-lane merge guards M==-inf: exp(-inf - -inf) would be NaN (§T428 lesson).

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer BufQ { float q[]; };
layout(std430, binding = 1) readonly buffer BufK { float k[]; };
layout(std430, binding = 2) readonly buffer BufV { float v[]; };
layout(std430, binding = 3) writeonly buffer BufO { float o[]; };

layout(push_constant) uniform P {
    int sq; int sk; int dm; int heads; int kvHeads; int dk; int causal; float scale;
} p;

void main() {
    int h = int(gl_WorkGroupID.x);
    int i = int(gl_WorkGroupID.y);
    if (h >= p.heads || i >= p.sq) return;
    uint lane = gl_SubgroupInvocationID;
    int rep = p.heads / p.kvHeads;
    int dkv = p.kvHeads * p.dk;
    int qOff = h * p.dk;
    int kvOff = (h / rep) * p.dk;
    int jmax = (p.causal != 0) ? (p.sk - p.sq + i + 1) : p.sk; // §T431 per-row causal bound

    float qreg[128];
    for (int d = 0; d < p.dk; d++) qreg[d] = q[i * p.dm + qOff + d];
    float m = -1.0 / 0.0;
    float l = 0.0;
    float acc[128];
    for (int d = 0; d < p.dk; d++) acc[d] = 0.0;

    for (int j = int(lane); j < jmax; j += 32) {
        float s = 0.0;
        for (int d = 0; d < p.dk; d++) s += qreg[d] * k[j * dkv + kvOff + d];
        s *= p.scale;
        float mNew = max(m, s);
        float corr = exp(m - mNew);
        float pw = exp(s - mNew);
        l = corr * l + pw;
        for (int d = 0; d < p.dk; d++) acc[d] = corr * acc[d] + pw * v[j * dkv + kvOff + d];
        m = mNew;
    }
    for (uint off = 16u; off > 0u; off >>= 1u) {
        float mo = subgroupShuffleDown(m, off);
        float lo = subgroupShuffleDown(l, off);
        float M = max(m, mo);
        float c1 = (M == -1.0 / 0.0) ? 0.0 : exp(m - M);
        float c2 = (M == -1.0 / 0.0) ? 0.0 : exp(mo - M);
        for (int d = 0; d < p.dk; d++) {
            float ao = subgroupShuffleDown(acc[d], off);
            acc[d] = c1 * acc[d] + c2 * ao;
        }
        l = c1 * l + c2 * lo;
        m = M;
    }
    if (lane == 0u) {
        for (int d = 0; d < p.dk; d++) o[i * p.dm + qOff + d] = acc[d] / l;
    }
}
