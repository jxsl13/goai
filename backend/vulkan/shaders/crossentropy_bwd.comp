#version 450

// Cross-entropy backward (ADR-0007, §R52/§R113), one invocation per ROW of the logits
// Z[b,c]. With stable softmax p, smoothed target q'(k)=(1−ε)δ(k,tᵢ)+ε/c and z-loss term
// 2·zl·lse·p: dz[i,k] = gv·(p_k − q'_k + 2·zl·lse·p_k)/b, where gv is the scalar upstream
// gradient. Targets are passed as floats (class indices). Flat row-major std430 f32
// buffers. Compiled to crossentropy_bwd.spv by `make vulkan-spv` (glslc). f32 vs the
// reference's f64, so §V11 allows a tolerance.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer BufZ { float z[]; };
layout(std430, binding = 1) readonly buffer BufT { float tg[]; };
layout(std430, binding = 2) writeonly buffer BufDZ { float dz[]; };

layout(push_constant) uniform Dims { int b; int c; float gv; float eps; float zl; } d;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(d.b)) {
        return;
    }
    uint base = i * uint(d.c);
    float m = z[base];
    for (int j = 1; j < d.c; ++j) {
        m = max(m, z[base + uint(j)]);
    }
    float sum = 0.0;
    for (int j = 0; j < d.c; ++j) {
        sum += exp(z[base + uint(j)] - m);
    }
    int ti = int(tg[i]);
    float lseTerm = 0.0;
    if (d.zl != 0.0) {
        lseTerm = 2.0 * d.zl * (m + log(sum));
    }
    float invb = 1.0 / float(d.b);
    for (int j = 0; j < d.c; ++j) {
        float p = exp(z[base + uint(j)] - m) / sum;
        float q = d.eps / float(d.c);
        if (j == ti) {
            q += 1.0 - d.eps;
        }
        dz[base + uint(j)] = d.gv * (p - q + lseTerm * p) * invb;
    }
}
