#version 450
#extension GL_EXT_shader_atomic_float : require

// LayerNorm backward (§R35). COOPERATIVE (§T347): ONE workgroup of 256 invocations per
// ROW, coalesced strided access. With x̂=(x−μ)/σ, σ=√(var+eps), a=g⊙γ per row: reductions
// in shared scratch give (1) mean, (2) variance, (3) meanA=Σa_j & meanAX=Σa_j·x̂_j (the
// combined pass also atomically adds dγ_j=g_j·x̂_j and dβ_j=g_j into the cross-row
// accumulators, host-zeroed). Then each lane writes its strided dx_j=(1/σ)·(a_j−meanA−x̂_j·meanAX).
// Flat row-major std430 f32. Compiled to layernorm_bwd.spv by `make vulkan-spv`; needs
// VK_EXT_shader_atomic_float (Go falls back to the reference otherwise). Dispatch is `rows`
// workgroups of 256. f32 vs the reference's f64, §V11 dim-scaled tolerance.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer BufX { float x[]; };
layout(std430, binding = 1) readonly buffer BufGamma { float gam[]; };
layout(std430, binding = 2) readonly buffer BufG { float gup[]; };
layout(std430, binding = 3) writeonly buffer BufDX { float dx[]; };
layout(std430, binding = 4) buffer BufDGamma { float dgamma[]; };
layout(std430, binding = 5) buffer BufDBeta { float dbeta[]; };

layout(push_constant) uniform Dims { int rows; int dim; float eps; } d;

shared float redA[256];
shared float redB[256];

void main() {
    uint row = gl_WorkGroupID.x;
    if (row >= uint(d.rows)) {
        return; // whole workgroup returns together → barriers stay uniform
    }
    uint lane = gl_LocalInvocationID.x;
    uint base = row * uint(d.dim);
    float fd = float(d.dim);

    float psum = 0.0;
    for (int j = int(lane); j < d.dim; j += 256) {
        psum += x[base + uint(j)];
    }
    redA[lane] = psum;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1) {
        if (lane < s) { redA[lane] += redA[lane + s]; }
        barrier();
    }
    float mean = redA[0] / fd;
    barrier();

    float pv = 0.0;
    for (int j = int(lane); j < d.dim; j += 256) {
        float dv = x[base + uint(j)] - mean;
        pv += dv * dv;
    }
    redA[lane] = pv;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1) {
        if (lane < s) { redA[lane] += redA[lane + s]; }
        barrier();
    }
    float inv = inversesqrt(redA[0] / fd + d.eps);
    barrier();

    float pa = 0.0;
    float pax = 0.0;
    for (int j = int(lane); j < d.dim; j += 256) {
        float xhat = (x[base + uint(j)] - mean) * inv;
        float gj = gup[base + uint(j)];
        float aj = gj * gam[uint(j)];
        pa += aj;
        pax += aj * xhat;
        atomicAdd(dgamma[uint(j)], gj * xhat);
        atomicAdd(dbeta[uint(j)], gj);
    }
    redA[lane] = pa;
    redB[lane] = pax;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1) {
        if (lane < s) { redA[lane] += redA[lane + s]; redB[lane] += redB[lane + s]; }
        barrier();
    }
    float meanA = redA[0] / fd;
    float meanAX = redB[0] / fd;
    for (int j = int(lane); j < d.dim; j += 256) {
        float xhat = (x[base + uint(j)] - mean) * inv;
        float aj = gup[base + uint(j)] * gam[uint(j)];
        dx[base + uint(j)] = inv * (aj - meanA - xhat * meanAX);
    }
}
