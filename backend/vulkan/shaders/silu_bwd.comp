#version 450

// SiLU backward dx = g·silu'(x), silu'(x)=σ(x)·(1+x·(1−σ(x))), σ=1/(1+e^−x), one
// invocation per element (§T362: SwiGLU's activation; the VJP was a ~29ms CPU scalar loop
// at the FFN's 256×2048). Flat row-major std430 f32. Compiled to silu_bwd.spv by
// `make vulkan-spv` (glslc). f32 vs the reference's f64, so §V11 allows a tolerance.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer BufX { float x[]; };
layout(std430, binding = 1) readonly buffer BufG { float g[]; };
layout(std430, binding = 2) writeonly buffer BufDX { float dx[]; };

layout(push_constant) uniform Dims { int n; } d;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(d.n)) {
        return;
    }
    float xv = x[i];
    float s = 1.0 / (1.0 + exp(-xv));
    dx[i] = g[i] * s * (1.0 + xv * (1.0 - s));
}
