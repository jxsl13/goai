#version 450
#extension GL_EXT_shader_atomic_float : require

// Embedding backward (§T34), one invocation per (token i, dim j) of the upstream gradient
// G[m,d]: scatter-add dtable[idx[i], j] += g[i, j] with a float atomicAdd, since several
// tokens may share an index and collide on the same table row. dtable[n,d] must be
// zero-initialized by the host; idx holds the token indices as floats. Flat row-major
// std430 f32 buffers. Compiled to embed_bwd.spv by `make vulkan-spv` (glslc); needs
// VK_EXT_shader_atomic_float (the Go dispatch falls back to the reference otherwise).

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer BufIdx { float idx[]; };
layout(std430, binding = 1) readonly buffer BufG { float g[]; };
layout(std430, binding = 2) buffer BufDT { float dtable[]; };

layout(push_constant) uniform Dims { int n; int d; int m; } dm;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint total = uint(dm.m) * uint(dm.d);
    if (gid >= total) {
        return;
    }
    uint i = gid / uint(dm.d);
    uint j = gid % uint(dm.d);
    int t = int(idx[i]);
    if (t < 0 || t >= dm.n) {
        return; // out-of-range index: skip (the reference errors; valid training never hits this)
    }
    atomicAdd(dtable[uint(t) * uint(dm.d) + j], g[gid]);
}
